# EduCompanion - Environment Configuration
# Copy this file to .env and fill in the values.

# REQUIRED: Secret key for sessions (min 32 chars, generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your-secret-key-here

# Server bind settings
FLASK_HOST=0.0.0.0
FLASK_PORT=8000

# Set to 'production' for production deployment (disables debug mode)
FLASK_ENV=production

# Optional: Force HTTPS in production by setting these
# SESSION_COOKIE_SECURE=True
# REMEMBER_COOKIE_SECURE=True